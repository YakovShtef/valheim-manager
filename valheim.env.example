# ---------------------------------------------------------------------------
# Valheim server settings. REFERENCE COPY -- you do not need to copy this file.
#
# The manager writes ./settings/valheim.env with exactly these values on its first
# boot, and the first-run wizard then fills in the ones you chose. From that point
# the file is yours: the manager only ever replaces the values of the keys it was
# asked to change, preserving your comments, blank lines, key order and any extra
# keys you add.
#
# Copy this file only to own it from the very start -- put it at
# ./settings/valheim.env BEFORE the first `docker compose up -d` and the manager
# will leave it byte-identical:
#
#   mkdir -p settings && cp valheim.env.example settings/valheim.env
#
# The manager displays these values (secrets masked) and passes them to the game
# container when it creates it. The dashboard's settings panel edits the core ones --
# and the SERVER_ARGS world modifiers below -- while the server is off; editing this
# file by hand still works for everything else, and the change reaches the game the
# same way: Stop, `docker rm valheim-server`, Start.
#
# Every variable below is documented by the upstream image:
# https://github.com/community-valheim-tools/valheim-server-docker
# ---------------------------------------------------------------------------

# Name shown in the in-game server browser.
SERVER_NAME=My Valheim Server

# World save name under /config/worlds_local. The world itself is created by the
# game server the first time you press Start; its seed is random and fixed from
# that moment on, because the dedicated server takes no seed argument.
WORLD_NAME=Dedicated

# UDP game port. The query port (+1) and crossplay backend port (+2) follow it.
SERVER_PORT=2456

# Join password. REQUIRED, at least 5 characters: valheim_server.x86_64 itself
# refuses to start without one -- whatever SERVER_PUBLIC says, and with no
# passwordless option outside ValheimPlus. Deliberately left empty here so an
# unedited copy of this file cannot put a server online under a password published
# in a repo; the manager's Start refuses while it is empty rather than handing you a
# container that exits a second later. Pick your own; it must not appear in
# SERVER_NAME.
#
# The manager reads this file itself and passes the value through untouched, so a
# `$` is safe on that path. The `--profile server` escape hatch, however, hands the
# file to Compose, which interpolates `$`: there `SERVER_PASS=abc$def` reaches the
# container as `abc`. Single-quote the value ('abc$def') or double the dollar ($$)
# if you use that path; easiest is to avoid `$` in the join password altogether.
SERVER_PASS=

# List the server in the public community browser (1/true) or keep it
# join-by-address only (0/false). Defaults to 0 on purpose: going public is an
# opt-in decision, and it should never happen just because someone copied this
# file without reading it. Set it to 1 only once SERVER_PASS is your own.
SERVER_PUBLIC=0

# Allow Xbox/Game Pass clients. Uses the PlayFab backend and publishes a join
# code instead of an address.
CROSSPLAY=false

# Extra command-line arguments for the game server -- where Valheim's world modifiers
# live. The dashboard's settings panel composes this line for you from its own
# controls: a preset, the combat/deathpenalty/resources/raids/portals categories, and
# the nobuildcost, playerevents, passivemobs and nomap toggles. For example:
#
#   SERVER_ARGS=-preset hard -modifier raids more -setkey nomap
#
# Order matters and the panel enforces it: `-preset` first, then every `-modifier
# <category> <value>`, then every `-setkey <name>`. Valheim applies these in sequence,
# so a preset written after a modifier silently flattens it back. A category left at
# its default is left out entirely -- `normal` is not one of the documented argument
# values, leaving the argument out is how the default is kept. Any other argument you
# put here is preserved exactly as written and kept after the modifiers.
#
# These are launch arguments, not world data: they change the rules the server plays
# by, and never alter or migrate an existing save. A new value reaches the game only
# when a new container is created (Save in the panel, then Start).
SERVER_ARGS=

# Run the server process as this uid/gid instead of root.
PUID=1000
PGID=1000

# Create worlds, backups and config group-writable (775 / 664) instead of the
# image's default 755 / 644. The manager runs as its own uid in this same group,
# and cannot chmod what the game server owns -- so without this, every world the
# game creates is one the manager can list but not upload beside, switch away
# from, or delete. Keep this at 002 unless you know you want otherwise.
PERMISSIONS_UMASK=002

TZ=Etc/UTC

# Keep the game files up to date on container start.
UPDATE_ON_START=true

# The image's own hourly world backup under /config/backups (a manual
# "Backup now" button is deferred).
BACKUPS=true
BACKUPS_INTERVAL=3600
BACKUPS_MAX_AGE=3
