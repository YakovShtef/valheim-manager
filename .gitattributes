# This repo is developed on Windows and deployed on Linux. Commit everything with
# LF so a clone on the server never receives CRLF -- a CRLF in the Dockerfile or in
# an entrypoint is the classic "works here, exits immediately there" bug.
* text=auto eol=lf

# Nothing here is binary, but be explicit about the ones that must never be touched.
*.png binary
*.jpg binary
*.ico binary
