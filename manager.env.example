# ===========================================================================
# MANAGER CREDENTIALS -- THE ADVANCED, OPTIONAL PATH. You almost certainly do not
# need this file.
#
# The normal install is:
#
#   docker compose up -d
#   docker compose logs manager     # open the one-time setup URL it prints
#
# The first-run wizard creates the admin account, generates the session secret,
# and stores both on the `valheim-manager-state` Docker volume at mode 0600. No
# hash tool, no invented secret, no file to edit.
#
# Copy this file only if you would rather pin the credentials yourself -- for a
# scripted deployment, a secrets manager, or to share one hash across hosts:
#
#   cp manager.env.example manager.env
#
# Setting all three variables below makes the manager skip first-run setup
# entirely: no token is logged and /setup is never available. It is all three or
# none -- a partial set refuses to boot rather than silently handing you the
# wizard. To go back to the wizard, remove this file (or empty the three values)
# AND delete the state volume: `docker volume rm valheim-manager-state`.
#
# Compose loads this file with `format: raw`, which is the only loader that passes
# a value through untouched.
#
#   *** NEVER put ADMIN_PASSWORD_HASH or SESSION_SECRET in .env ***
#
# Why: Compose interpolates `$` in .env and in a default-format env_file. Every
# bcrypt hash is `$2b$12$...` and every argon2 hash is `$argon2id$v=19$...`, so
# `$12`, `$argon2id` and the digest tail get read as variable references and
# replaced with blank strings. `$2b$12$abc...` silently becomes `$2b$12`, login
# then fails forever with nothing but "Invalid username or password".
# The manager detects a truncated hash at startup and names this cause, but the
# fix is to keep the value in this file.
#
#   *** DO NOT QUOTE THE VALUES BELOW ***
#
# Why: `format: raw` takes the line literally. Wrap the hash in quotes and the
# quotes become part of the password hash. Bare values only -- no ' and no ".
# (This is the opposite of the rule in .env, which DOES need single quotes.)
# ===========================================================================


# The single admin account's username.
ADMIN_USER=admin


# bcrypt or argon2 hash of the admin password. A bare SHA/MD5 digest, a truncated
# hash, or a quoted value are each rejected at startup with a specific error --
# that check is unchanged, and a manager configured this way still refuses to boot
# on a bad hash rather than falling back to the setup wizard.
#
# Generate one (no local Python needed):
#   docker compose run --rm --no-deps manager python tools/hash_password.py
#
# Paste the printed line here, exactly as printed. Example of the expected shape
# (60 characters for bcrypt -- this one is a placeholder, it will not work):
# ADMIN_PASSWORD_HASH=$2b$12$OcE1o5ZQ0000000000000uKL9wNJbT0e1cOe1dQ9r6qHRSf3wEXa
ADMIN_PASSWORD_HASH=


# Signs the session cookie. At least 16 characters. Keep it stable -- that is what
# keeps you signed in across `docker compose restart manager`; changing it
# invalidates every existing session.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
