# ===========================================================================
# COMPOSE-LEVEL SETTINGS -- ENTIRELY OPTIONAL.
#
# `docker compose up -d` works with no configuration files at all: the manager
# boots unconfigured and prints a one-time setup URL. Copy this file only if you
# want to change one of the knobs below.
#
#   cp manager/.env.example .env     # repo root, next to docker-compose.yml
#
# Compose reads this file for `${VAR}` interpolation in docker-compose.yml.
# Nothing here is a secret, and nothing here contains a `$`.
#
#   *** NEVER put ADMIN_PASSWORD_HASH or SESSION_SECRET in this file ***
#
# Compose interpolates `$` here, and every bcrypt (`$2b$12$...`) and argon2
# (`$argon2id$v=19$...`) hash contains `$` -- the value is silently truncated at
# the second `$` and login can then never succeed. The setup wizard avoids the
# whole problem by storing credentials on a volume instead of in a file; if you
# insist on setting them yourself, they go in ./manager.env, which Compose loads
# with `format: raw`. See manager.env.example.
#
# Values in THIS file: if one ever needs a literal `$`, single-quote it.
# ===========================================================================
#
# What lives where:
#
#   .env         (this file)  Optional Compose knobs: ports, image tag,
#                             container/volume names, log tuning, cookie/origin.
#   manager.env               Optional override for ADMIN_USER,
#                             ADMIN_PASSWORD_HASH, SESSION_SECRET; setting all
#                             three skips first-run setup. -> manager.env.example
#   settings/valheim.env      Game settings. Written by the manager on first boot
#                             and yours to edit afterwards; it never overwrites a
#                             file that already exists. -> valheim.env.example
#   valheim-manager-state     Docker volume holding the manager's own credentials
#                             at mode 0600. Never hand-edited.
#
# ===========================================================================


# === manager: session and origin behaviour =================================

# How long a session stays valid, in seconds (default 7 days). Minimum 60 -- a
# shorter session expires before it can be used, so the manager refuses to start
# rather than leaving you in a login redirect loop.
SESSION_MAX_AGE_SECONDS=604800

# Set true ONLY when the manager is reached over HTTPS; otherwise the browser
# will refuse to store the cookie.
COOKIE_SECURE=false

# Extra origins accepted on state-changing requests, comma separated. Same-origin
# requests are always accepted, so this is only needed behind a reverse proxy that
# rewrites Host, e.g. https://valheim.lan
ALLOWED_ORIGINS=


# === manager: where the WebUI listens ======================================

# 0.0.0.0 publishes on every interface the host has. Behind home NAT that is your
# LAN (the intended default) -- never forward this port on your router. On a VPS or
# any host with a public address it is internet-facing immediately, and this login
# has no rate limiting: use 127.0.0.1 there and reach it over SSH/VPN.
MANAGER_BIND=0.0.0.0
MANAGER_PORT=8080

# The address you actually reach the manager on, e.g. http://valheim.lan:8080.
# Optional, and used for exactly one thing: printing a ready-to-click first-run
# setup URL instead of one with a <this-host> placeholder. The manager never calls
# itself, and this is not an access control of any kind.
MANAGER_URL=

# Host path of the OPTIONAL manager secrets file (loaded with `format: raw`).
# Leave it absent and the first-run wizard stores the credentials itself.
MANAGER_ENV_FILE=./manager.env

# The uid/gid the manager process runs as. It must be able to write the settings
# directory below. The default matches the image and the state volume, so leave it
# alone unless a native-Linux host reports that the manager cannot write
# ./settings -- in which case either `sudo chown -R 10001:10001 settings` or set
# these to your own `id -u` / `id -g` (and then `docker volume rm
# valheim-manager-state` first, since that volume is initialised for 10001).
MANAGER_UID=10001
MANAGER_GID=10001


# === game container: identity and lifecycle ================================

VALHEIM_CONTAINER_NAME=valheim-server
VALHEIM_IMAGE=ghcr.io/community-valheim-tools/valheim-server:latest

# Docker restart policy for the game container: no | unless-stopped | always
VALHEIM_RESTART_POLICY=unless-stopped

# Seconds the engine waits after SIGTERM before SIGKILL. The image needs a
# generous window to flush the world save -- do not go below 60.
VALHEIM_STOP_TIMEOUT=120

# Host path of the settings DIRECTORY, mounted read-write into the manager at
# /srv/settings. The manager owns valheim.env inside it: it creates that file with
# documented defaults if it is absent, and otherwise leaves it exactly as it is. A
# directory rather than a single file because Docker turns a missing bind-mount
# source into a directory, and a settings *file* that had become a directory was a
# trap worth retiring.
VALHEIM_SETTINGS_DIR=./settings

# Published game ports, used only by the `--profile server` fallback path. When
# the manager creates the container it derives these from SERVER_PORT in
# settings/valheim.env (SERVER_PORT, +1 query, +2 crossplay), so keep the two in step.
VALHEIM_PORTS=2456-2458:2456-2458/udp


# === manager: status and log behaviour =====================================

# Regex (case-insensitive) that marks the server as *ready* rather than merely
# running. Default matches the Valheim server's own stdout line
# "Game server connected". Override only if a game update changes the wording.
READY_LOG_PATTERN=

# Lines backfilled into the console when the WebSocket (re)connects.
LOG_TAIL_LINES=200

# How often the manager polls the container log, in seconds. Floor 0.2 -- anything
# lower is clamped, since it busy-loops against the socket proxy per browser tab.
LOG_POLL_SECONDS=1.0

# Send a status push every Nth log poll (minimum 1).
STATUS_EVERY_N_POLLS=2

# Size cap on the game container's log file. Docker's json-file driver keeps no
# limit by default, and this is the log the manager reads for readiness and for the
# console, so an uncapped one grows forever on a long-lived server.
VALHEIM_LOG_MAX_SIZE=20m
VALHEIM_LOG_MAX_FILES=5


# === socket proxy ==========================================================
# Not configurable from here on purpose: the endpoint allowlist is pinned in
# docker-compose.yml so widening the manager's Docker access is a visible,
# reviewable edit rather than an env tweak.
